# ResidentCement MVP - Board Presentation Ready
# Security Hardened Dockerfile
# Audit Session: forensics1032026

FROM node:20-alpine

# Add labels for audit trail
LABEL maintainer="ResidentCement Team"
LABEL audit.session="forensics1032026"
LABEL security.hardened="true"

WORKDIR /app

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 -G nodejs

COPY package*.json ./

# Install dependencies with cache cleanup
RUN npm ci --only=production && \
    npm cache clean --force

COPY dist/ ./dist/

# Change ownership to non-root user
RUN chown -R nodejs:nodejs /app

# Switch to non-root user
USER nodejs

EXPOSE 3001

# Health check for runtime validation
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3001/health || exit 1

# Run as read-only where possible
CMD ["node", "dist/index.js"]
