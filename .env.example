# ResidentCement Environment Variables Template
# Copy this file to .env and fill in with secure values
# NEVER commit .env file to version control

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment (development, staging, production)
NODE_ENV=development

# API Gateway Port
PORT=3001

# Service Name
SERVICE_NAME=api-gateway

# =============================================================================
# DATABASE CONFIGURATION - PostgreSQL
# =============================================================================

# Generate secure password: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD

# Database connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resident_cement
DB_USER=resident_cement

# Full connection string (update password above)
DATABASE_URL="postgresql://resident_cement:CHANGE_ME_GENERATE_SECURE_PASSWORD@localhost:5432/resident_cement"

# =============================================================================
# DATABASE CONFIGURATION - MongoDB
# =============================================================================

# Generate secure password: openssl rand -base64 32
MONGO_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD

# MongoDB connection settings
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=resident_cement
MONGO_USER=resident_cement

# Full connection string (update password above)
MONGODB_URI="mongodb://resident_cement:CHANGE_ME_GENERATE_SECURE_PASSWORD@localhost:27017/resident_cement"

# =============================================================================
# CACHE CONFIGURATION - Redis
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
# Redis password (optional, recommended for production)
# REDIS_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD
REDIS_URL="redis://localhost:6379"

# =============================================================================
# MESSAGE BUS - Kafka
# =============================================================================

KAFKA_BROKERS=localhost:9092
# Kafka SASL authentication (for production)
# KAFKA_SASL_USERNAME=CHANGE_ME
# KAFKA_SASL_PASSWORD=CHANGE_ME

# =============================================================================
# AUTHENTICATION - JWT (CRITICAL - MUST BE SECURE)
# =============================================================================

# Generate secure JWT secret: openssl rand -base64 64
# MUST be at least 32 characters for security
JWT_SECRET=CHANGE_ME_GENERATE_64_CHAR_SECURE_SECRET

# JWT Configuration
JWT_ISSUER=resident-cement
JWT_AUDIENCE=resident-cement-api
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# IDENTITY PROVIDER - Keycloak
# =============================================================================

KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=resident-cement
KEYCLOAK_CLIENT_ID=resident-cement-api
# Keycloak admin credentials (for initial setup only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD

# =============================================================================
# API SECURITY
# =============================================================================

# Generate secure API key: openssl rand -hex 32
API_KEY=CHANGE_ME_GENERATE_SECURE_API_KEY

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
# For production, use: CORS_ORIGIN=https://app.residentcement.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_AUTH_MAX_REQUESTS=20

# =============================================================================
# OBJECT STORAGE - MinIO/S3
# =============================================================================

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME_GENERATE_SECURE_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_GENERATE_SECURE_SECRET_KEY
# Generate secure credentials: openssl rand -hex 20

# =============================================================================
# PAYMENT GATEWAY - Paystack
# =============================================================================

# Paystack API Keys (get from Paystack dashboard)
PAYSTACK_PUBLIC_KEY=pk_live_CHANGE_ME
PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME
PAYSTACK_WEBHOOK_SECRET=whsec_CHANGE_ME

# =============================================================================
# PAYMENT GATEWAY - Flutterwave (Alternative)
# =============================================================================

FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_CHANGE_ME
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_CHANGE_ME
FLUTTERWAVE_ENCRYPTION_KEY=FLWENC_CHANGE_ME

# =============================================================================
# EMAIL CONFIGURATION - SMTP
# =============================================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD
SMTP_FROM=noreply@residentcement.com

# =============================================================================
# USSD SERVICE - Africa's Talking
# =============================================================================

# Africa's Talking API Credentials
# Get from https://account.africastalking.com/
# For sandbox testing, use username: sandbox
AT_USERNAME=sandbox
AT_API_KEY=CHANGE_ME_GET_FROM_AFRICASTALKING
AT_SHORTCODE=*384*12345#
AT_SENDER_ID=ResidentCement
# Enable SMS sending (set to 'true' in production)
AT_SMS_ENABLED=false

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

LOG_LEVEL=info
# For production: LOG_LEVEL=warn or LOG_LEVEL=error

# =============================================================================
# FRONTEND CONFIGURATION (Public - NEXT_PUBLIC_*)
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. NEVER commit .env file to version control
# 2. Use different secrets for development, staging, and production
# 3. Rotate secrets regularly (minimum every 90 days)
# 4. Use a secrets manager in production (HashiCorp Vault, AWS Secrets Manager)
# 5. Generate secure passwords using: openssl rand -base64 32
# 6. Generate secure API keys using: openssl rand -hex 32
# 7. Store production secrets in environment variables, not files
