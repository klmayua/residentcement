# ResidentCement Production Environment Configuration
# Generated: 2026-03-11
# SECURITY WARNING: Keep this file secure. Never commit to version control.

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

NODE_ENV=production
PORT=3001
SERVICE_NAME=api-gateway

# =============================================================================
# DATABASE CONFIGURATION - PostgreSQL
# =============================================================================

# PRODUCTION: Replace with secure generated passwords
POSTGRES_PASSWORD=prod_secure_password_change_me_$(openssl rand -base64 32)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=resident_cement
POSTGRES_USER=resident_cement

DATABASE_URL="postgresql://resident_cement:prod_secure_password_change_me@postgres:5432/resident_cement"

# =============================================================================
# DATABASE CONFIGURATION - MongoDB
# =============================================================================

MONGO_PASSWORD=prod_secure_mongo_password_change_me
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=resident_cement
MONGO_USER=resident_cement

MONGODB_URI="mongodb://resident_cement:prod_secure_mongo_password_change_me@mongodb:27017/resident_cement"

# =============================================================================
# CACHE CONFIGURATION - Redis
# =============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL="redis://redis:6379"

# =============================================================================
# MESSAGE BUS - Kafka
# =============================================================================

KAFKA_BROKERS=kafka:29092

# =============================================================================
# AUTHENTICATION - JWT (CRITICAL)
# =============================================================================

# PRODUCTION: Generate with: openssl rand -base64 64
JWT_SECRET=prod_super_secure_jwt_secret_change_me_generate_proper_key
JWT_ISSUER=https://auth.residentcement.com/realms/resident-cement
JWT_AUDIENCE=resident-cement-api
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# IDENTITY PROVIDER - Keycloak
# =============================================================================

KEYCLOAK_URL=https://auth.residentcement.com
KEYCLOAK_REALM=resident-cement
KEYCLOAK_CLIENT_ID=resident-cement-api
KEYCLOAK_JWKS_URL=https://auth.residentcement.com/realms/resident-cement/protocol/openid-connect/certs

# =============================================================================
# API SECURITY
# =============================================================================

API_KEY=prod_secure_api_key_change_me_$(openssl rand -hex 32)
CORS_ORIGIN=https://app.residentcement.com

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_AUTH_MAX_REQUESTS=20

# =============================================================================
# OBJECT STORAGE - MinIO
# =============================================================================

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=prod_minio_access_key_change_me
MINIO_SECRET_KEY=prod_minio_secret_key_change_me

# =============================================================================
# PAYMENT GATEWAY - Paystack
# =============================================================================

PAYSTACK_PUBLIC_KEY=pk_live_YOUR_ACTUAL_PRODUCTION_KEY
PAYSTACK_SECRET_KEY=sk_live_YOUR_ACTUAL_PRODUCTION_SECRET
PAYSTACK_WEBHOOK_SECRET=whsec_YOUR_ACTUAL_WEBHOOK_SECRET

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

SMTP_HOST=smtp.production-mail.com
SMTP_PORT=587
SMTP_USER=noreply@residentcement.com
SMTP_PASSWORD=prod_smtp_password_change_me
SMTP_FROM=noreply@residentcement.com

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=warn

# =============================================================================
# FRONTEND (Public URLs)
# =============================================================================

NEXT_PUBLIC_API_URL=https://api.residentcement.com
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.residentcement.com
NEXT_PUBLIC_APP_URL=https://app.residentcement.com
