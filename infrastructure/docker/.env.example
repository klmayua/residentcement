# Production Environment Configuration
# Copy to .env and fill in actual values before deployment

# Database Configuration
DB_USER=residentcement
DB_PASSWORD=change_this_to_secure_password
DB_NAME=residentcement

# Redis Configuration
REDIS_PASSWORD=change_this_to_secure_password

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# Admin Credentials
GRAFANA_PASSWORD=change_this_to_secure_password

# Domains
DOMAIN_RESIDENTCEMENT=residentcement.com
DOMAIN_API=api.residentcement.com
DOMAIN_APP=app.residentcement.com
DOMAIN_MONITOR=monitor.residentcement.com
DOMAIN_GRAFANA=grafana.residentcement.com
DOMAIN_PROMETHEUS=prometheus.residentcement.com

# Email for Let's Encrypt
ACME_EMAIL=admin@residentcement.com

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=residentcement-backups
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
