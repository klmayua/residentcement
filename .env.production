# ResidentCement Production Environment
# IMPORTANT: Replace ALL placeholder values before deployment
# Generate secrets using: bash scripts/rotate_secrets.sh

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=production
PORT=3001
SERVICE_NAME=api-gateway

# =============================================================================
# DATABASE - PostgreSQL
# =============================================================================
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=resident_cement
POSTGRES_USER=resident_cement
DATABASE_URL="postgresql://resident_cement:REPLACE_WITH_GENERATED_SECRET@postgres:5432/resident_cement"

# =============================================================================
# DATABASE - MongoDB
# =============================================================================
MONGO_PASSWORD=REPLACE_WITH_GENERATED_SECRET
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGODB_URI="mongodb://resident_cement:REPLACE_WITH_GENERATED_SECRET@mongodb:27017/resident_cement"

# =============================================================================
# REDIS
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL="redis://redis:6379"

# =============================================================================
# KAFKA
# =============================================================================
KAFKA_BROKERS=kafka:29092

# =============================================================================
# JWT AUTHENTICATION (CRITICAL)
# =============================================================================
JWT_SECRET=REPLACE_WITH_64_CHAR_SECURE_SECRET
JWT_ISSUER=https://auth.residentcement.com/realms/resident-cement
JWT_AUDIENCE=resident-cement-api

# =============================================================================
# KEYCLOAK
# =============================================================================
KEYCLOAK_URL=https://auth.residentcement.com
KEYCLOAK_REALM=resident-cement
KEYCLOAK_CLIENT_ID=resident-cement-api
KEYCLOAK_JWKS_URL=https://auth.residentcement.com/realms/resident-cement/protocol/openid-connect/certs

# =============================================================================
# API SECURITY
# =============================================================================
API_KEY=REPLACE_WITH_GENERATED_API_KEY
CORS_ORIGIN=https://app.residentcement.com

# =============================================================================
# MINIO
# =============================================================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_GENERATED_KEY
MINIO_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET

# =============================================================================
# PAYSTACK (Production Keys from Dashboard)
# =============================================================================
PAYSTACK_PUBLIC_KEY=pk_live_YOUR_KEY_HERE
PAYSTACK_SECRET_KEY=sk_live_YOUR_SECRET_HERE
PAYSTACK_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=warn

# =============================================================================
# FRONTEND URLs
# =============================================================================
NEXT_PUBLIC_API_URL=https://api.residentcement.com
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.residentcement.com
NEXT_PUBLIC_APP_URL=https://app.residentcement.com
