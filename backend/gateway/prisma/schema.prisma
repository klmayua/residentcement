// ResidentCement Prisma Schema
// Main database schema for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// User & Authentication
// =============================================================================

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String
  phone            String?
  passwordHash     String
  role             UserRole  @default(VIEWER)
  status           UserStatus @default(PENDING_VERIFICATION)
  emailVerified    Boolean   @default(false)
  emailVerifiedAt  DateTime?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  
  // Relations
  sessions         Session[]
  auditLogs        AuditLog[]
  createdCustomers Customer[] @relation("CustomerCreator")
  updatedCustomers Customer[] @relation("CustomerUpdater")

  @@index([email])
  @@index([role, status])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("users")
}

enum UserRole {
  ADMIN
  STAFF
  DISTRIBUTOR
  SALES_REP
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([userId, expiresAt])
  @@map("sessions")
}

// =============================================================================
// Customer Domain
// =============================================================================

model Customer {
  id              String        @id @default(uuid())
  name            String
  email           String        @unique
  phone           String?
  address         String?
  city            String?
  state           String?
  lga             String?
  country         String        @default("Nigeria")
  postalCode      String?
  tier            CustomerTier  @default(STANDARD)
  status          CustomerStatus @default(PROSPECT)
  creditLimit     Decimal       @default(0) @db.Decimal(15, 2)
  contactPerson   String?
  contactEmail    String?
  contactPhone    String?
  taxId           String?
  registrationNumber String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deactivatedAt   DateTime?
  createdById     String?
  updatedById     String?
  
  // Relations
  orders          Order[]
  quotes          Quote[]
  payments        Payment[]
  addresses       CustomerAddress[]
  createdBy       User?         @relation("CustomerCreator", fields: [createdById], references: [id])
  updatedBy       User?         @relation("CustomerUpdater", fields: [updatedById], references: [id])
  
  @@index([email])
  @@index([phone])
  @@index([tier, status])
  @@index([state, lga])
  @@map("customers")
}

enum CustomerTier {
  STANDARD
  SILVER
  GOLD
  PLATINUM
  ENTERPRISE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PROSPECT
}

model CustomerAddress {
  id           String  @id @default(uuid())
  customerId   String
  type         AddressType @default(DELIVERY)
  isDefault    Boolean @default(false)
  address      String
  city         String
  state        String
  lga          String
  country      String  @default("Nigeria")
  postalCode   String?
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  @@index([customerId])
  @@map("customer_addresses")
}

enum AddressType {
  DELIVERY
  BILLING
  WAREHOUSE
  OFFICE
}

// =============================================================================
// Product Domain
// =============================================================================

model Product {
  id              String         @id @default(uuid())
  name            String
  sku             String         @unique
  description     String?
  category        ProductCategory
  subcategory     String?
  status          ProductStatus  @default(ACTIVE)
  basePrice       Decimal        @db.Decimal(15, 2)
  costPrice       Decimal?       @db.Decimal(15, 2)
  unitOfMeasure   String         @default("unit")
  weight          Decimal?       @db.Decimal(10, 3)
  volume          Decimal?       @db.Decimal(10, 3)
  dimensions      String?        // JSON: {length, width, height}
  manufacturer    String?
  brand           String?
  tags            String[]
  images          String[]       // URLs
  specifications  Json?
  minOrderQty     Int            @default(1)
  maxOrderQty     Int?
  isTaxable       Boolean        @default(true)
  taxRate         Decimal        @default(7.5) @db.Decimal(5, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  
  // Relations
  inventory       Inventory[]
  orderItems      OrderItem[]
  quoteItems      QuoteItem[]
  pricingRules    PricingRule[]
  
  @@index([sku])
  @@index([category, status])
  @@index([brand])
  @@map("products")
}

enum ProductCategory {
  CEMENT
  CONCRETE
  AGGREGATE
  ADDITIVE
  EQUIPMENT
  SPARE_PARTS
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
  OUT_OF_STOCK
}

// =============================================================================
// Inventory Domain
// =============================================================================

model Warehouse {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  type        WarehouseType @default(DISTRIBUTION)
  address     String
  city        String
  state       String
  lga         String
  country     String   @default("Nigeria")
  postalCode  String?
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  capacity    Decimal  @db.Decimal(15, 2) // in tons or cubic meters
  currentUtilization Decimal @default(0) @db.Decimal(5, 2) // percentage
  isActive    Boolean  @default(true)
  managerName String?
  managerPhone String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  inventory   Inventory[]
  stockMovements StockMovement[]
  
  @@index([code])
  @@index([state, city])
  @@map("warehouses")
}

enum WarehouseType {
  MANUFACTURING
  DISTRIBUTION
  RETAIL
  TRANSIT
}

model Inventory {
  id              String   @id @default(uuid())
  productId       String
  warehouseId     String
  batchNumber     String?
  quantity        Int      @default(0)
  reservedQuantity Int     @default(0)
  availableQuantity Int    @default(0) // Computed: quantity - reservedQuantity
  reorderLevel    Int      @default(100)
  reorderQuantity Int      @default(500)
  status          InventoryStatus @default(AVAILABLE)
  manufacturingDate DateTime?
  expiryDate      DateTime?
  receivedDate    DateTime @default(now())
  unitCost        Decimal  @db.Decimal(15, 2)
  location        String?  // Bin/shelf location
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  product         Product  @relation(fields: [productId], references: [id])
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  stockMovements  StockMovement[]
  
  @@unique([productId, warehouseId, batchNumber])
  @@index([productId])
  @@index([warehouseId])
  @@index([status])
  @@map("inventory")
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  IN_TRANSIT
  QUARANTINED
  EXPIRED
  DAMAGED
}

model StockMovement {
  id            String   @id @default(uuid())
  inventoryId   String
  warehouseId   String
  type          StockMovementType
  quantity      Int
  referenceType String?  // ORDER, QUOTE, ADJUSTMENT, etc.
  referenceId   String?
  reason        String?
  notes         String?
  performedBy   String?
  createdAt     DateTime @default(now())
  
  inventory     Inventory @relation(fields: [inventoryId], references: [id])
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  
  @@index([inventoryId])
  @@index([warehouseId])
  @@index([type, createdAt])
  @@map("stock_movements")
}

enum StockMovementType {
  RECEIPT
  DISPATCH
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
  DAMAGE
  EXPIRY
}

// =============================================================================
// Order Domain
// =============================================================================

model Order {
  id              String   @id @default(uuid())
  orderNumber     String   @unique
  customerId      String
  status          OrderStatus @default(PENDING)
  priority        OrderPriority @default(NORMAL)
  source          OrderSource @default(WEB)
  items           OrderItem[]
  subtotal        Decimal  @db.Decimal(15, 2)
  tax             Decimal  @default(0) @db.Decimal(15, 2)
  discount        Decimal  @default(0) @db.Decimal(15, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  shippingCost    Decimal  @default(0) @db.Decimal(15, 2)
  total           Decimal  @db.Decimal(15, 2)
  currency        String   @default("NGN")
  shippingAddress String
  shippingCity    String
  shippingState   String
  shippingLga     String
  deliveryDate    DateTime?
  shippedDate     DateTime?
  deliveredDate   DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  notes           String?
  internalNotes   String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  customer        Customer @relation(fields: [customerId], references: [id])
  payments        Payment[]
  
  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  IN_PRODUCTION
  READY_FOR_SHIPMENT
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OrderSource {
  WEB
  MOBILE
  USSD
  PHONE
  EMAIL
  WALK_IN
  API
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  productName String  // Snapshot at order time
  sku         String  // Snapshot at order time
  quantity    Int
  unitPrice   Decimal @db.Decimal(15, 2)
  discount    Decimal @default(0) @db.Decimal(15, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  tax         Decimal @default(0) @db.Decimal(15, 2)
  taxPercent  Decimal @default(7.5) @db.Decimal(5, 2)
  total       Decimal @db.Decimal(15, 2)
  fulfilledQty Int @default(0)
  status      OrderItemStatus @default(PENDING)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
  
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

enum OrderItemStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

// =============================================================================
// Quote Domain
// =============================================================================

model Quote {
  id              String   @id @default(uuid())
  quoteNumber     String   @unique
  customerId      String
  status          QuoteStatus @default(DRAFT)
  items           QuoteItem[]
  subtotal        Decimal  @db.Decimal(15, 2)
  tax             Decimal  @default(0) @db.Decimal(15, 2)
  discount        Decimal  @default(0) @db.Decimal(15, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  total           Decimal  @db.Decimal(15, 2)
  currency        String   @default("NGN")
  validUntil      DateTime
  notes           String?
  terms           String?
  convertedToOrderId String?
  convertedAt     DateTime?
  rejectedReason  String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  customer        Customer @relation(fields: [customerId], references: [id])
  payments        Payment[]
  
  @@index([quoteNumber])
  @@index([customerId])
  @@index([status])
  @@map("quotes")
}

enum QuoteStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  productId   String
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal @db.Decimal(15, 2)
  discount    Decimal @default(0) @db.Decimal(15, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  tax         Decimal @default(0) @db.Decimal(15, 2)
  taxPercent  Decimal @default(7.5) @db.Decimal(5, 2)
  total       Decimal @db.Decimal(15, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
  
  @@index([quoteId])
  @@index([productId])
  @@map("quote_items")
}

// =============================================================================
// Payment Domain
// =============================================================================

model Payment {
  id              String   @id @default(uuid())
  paymentReference String @unique
  orderId         String?
  customerId      String
  quoteId         String?
  amount          Decimal  @db.Decimal(15, 2)
  currency        String   @default("NGN")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  provider        String?  // Paystack, Flutterwave, etc.
  providerReference String?
  providerResponse Json?
  metadata        Json?
  paidAt          DateTime?
  failedAt        DateTime?
  failureReason   String?
  refundedAt      DateTime?
  refundAmount    Decimal? @db.Decimal(15, 2)
  refundReason    String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  customer        Customer @relation(fields: [customerId], references: [id])
  order           Order?   @relation(fields: [orderId], references: [id])
  quote           Quote?   @relation(fields: [quoteId], references: [id])
  
  @@index([paymentReference])
  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([method])
  @@map("payments")
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
  CASH
  CHEQUE
  CREDIT
  POS
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
  DISPUTED
}

// =============================================================================
// Pricing Domain
// =============================================================================

model PricingRule {
  id            String   @id @default(uuid())
  name          String
  description   String?
  ruleType      PricingRuleType
  scope         PricingScope
  scopeValue    String?  // Customer ID, tier, region, etc.
  productId     String?
  categoryId    String?
  customerTier  CustomerTier?
  value         Decimal  @db.Decimal(15, 2) // Discount % or fixed amount
  valueType     PricingValueType @default(PERCENTAGE)
  minQuantity   Int?
  maxQuantity   Int?
  minOrderValue Decimal? @db.Decimal(15, 2)
  startDate     DateTime
  endDate       DateTime?
  isActive      Boolean  @default(true)
  priority      Int      @default(0) // Higher priority rules apply first
  stackable     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  product       Product? @relation(fields: [productId], references: [id])
  
  @@index([ruleType])
  @@index([scope, scopeValue])
  @@index([isActive])
  @@index([startDate, endDate])
  @@map("pricing_rules")
}

enum PricingRuleType {
  FIXED
  PERCENTAGE
  TIERED
  VOLUME_BASED
  BUNDLE
}

enum PricingScope {
  GLOBAL
  CUSTOMER_TIER
  CUSTOMER
  REGION
  PRODUCT_CATEGORY
  PRODUCT
}

enum PricingValueType {
  PERCENTAGE
  FIXED_AMOUNT
}

// =============================================================================
// Audit & System
// =============================================================================

model AuditLog {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  action      AuditAction
  userId      String?
  userEmail   String?
  changes     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  user        User?    @relation(fields: [userId], references: [id])
  
  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  READ
  LOGIN
  LOGOUT
  APPROVE
  REJECT
}

// =============================================================================
// System Configuration
// =============================================================================

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  type      String
  category  String?
  isPublic  Boolean  @default(false)
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("system_configs")
}

// =============================================================================
// Accounting Domain (Nigerian GAAP Compliant)
// =============================================================================

model Account {
  id              String        @id @default(uuid())
  code            String        @unique // 4-digit account code
  name            String
  type            AccountType
  subtype         AccountSubType
  parentId        String?       // Hierarchical chart of accounts
  parent          Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        Account[]     @relation("AccountHierarchy")

  isBankAccount   Boolean       @default(false)
  isControlAccount Boolean      @default(false)
  currency        String        @default("NGN")

  // Balance tracking
  openingBalance  Decimal       @default(0) @db.Decimal(15, 2)
  currentBalance  Decimal       @default(0) @db.Decimal(15, 2)

  // Bank account details (if applicable)
  bankCode        String?
  bankName        String?
  accountNumber   String?

  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  journalLines    JournalEntryLine[]

  @@index([type, subtype])
  @@index([isActive])
  @@index([parentId])
  @@map("accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSubType {
  CURRENT_ASSET
  FIXED_ASSET
  INTANGIBLE_ASSET
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  EQUITY
  OPERATING_REVENUE
  OTHER_REVENUE
  COST_OF_SALES
  OPERATING_EXPENSE
  OTHER_EXPENSE
}

model JournalEntry {
  id              String            @id @default(uuid())
  entryNumber     String            @unique // JE-YYYY-NNNNNN
  entryDate       DateTime
  periodId        String
  period          AccountingPeriod  @relation(fields: [periodId], references: [id])

  reference       String?           // External reference number
  description     String

  sourceDocument  String?           // INVOICE, PAYMENT, etc.
  sourceId        String?           // ID of source document

  // Totals
  totalDebit      Decimal           @default(0) @db.Decimal(15, 2)
  totalCredit     Decimal           @default(0) @db.Decimal(15, 2)

  status          JournalEntryStatus @default(DRAFT)
  postedAt        DateTime?
  postedById      String?
  postedBy        User?             @relation(fields: [postedById], references: [id])

  createdById     String
  createdBy       User              @relation("JournalEntryCreator", fields: [createdById], references: [id])

  // Relations
  lines           JournalEntryLine[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([entryDate])
  @@index([status])
  @@index([periodId])
  @@index([sourceDocument, sourceId])
  @@map("journal_entries")
}

enum JournalEntryStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  REVERSED
}

model JournalEntryLine {
  id              String        @id @default(uuid())
  journalEntryId  String
  journalEntry    JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId       String
  account         Account       @relation(fields: [accountId], references: [id])

  description     String
  debitAmount     Decimal       @default(0) @db.Decimal(15, 2)
  creditAmount    Decimal       @default(0) @db.Decimal(15, 2)

  // Dimensions
  costCenter      String?
  projectCode     String?
  department      String?

  // Link to source
  sourceDocument  String?
  sourceId        String?

  lineOrder       Int           @default(0)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([costCenter])
  @@map("journal_entry_lines")
}

model AccountingPeriod {
  id              String        @id @default(uuid())
  fiscalYearId    String
  fiscalYear      FiscalYear    @relation(fields: [fiscalYearId], references: [id])

  year            Int
  month           Int           // 1-12
  periodStart     DateTime
  periodEnd       DateTime

  status          PeriodStatus  @default(OPEN)
  isClosed        Boolean       @default(false)
  closedAt        DateTime?
  closedById      String?
  closedBy        User?         @relation(fields: [closedById], references: [id])

  // Period totals
  totalRevenue    Decimal       @default(0) @db.Decimal(15, 2)
  totalExpenses   Decimal       @default(0) @db.Decimal(15, 2)

  // Relations
  journalEntries  JournalEntry[]

  @@unique([year, month])
  @@index([status, isClosed])
  @@map("accounting_periods")
}

enum PeriodStatus {
  OPEN
  PENDING_CLOSE
  CLOSED
}

model FiscalYear {
  id              String            @id @default(uuid())
  year            Int               @unique
  startDate       DateTime
  endDate         DateTime
  status          FiscalYearStatus  @default(ACTIVE)

  isClosed        Boolean           @default(false)
  closedAt        DateTime?
  closedById      String?
  closedBy        User?             @relation(fields: [closedById], references: [id])

  // Relations
  periods         AccountingPeriod[]

  @@map("fiscal_years")
}

enum FiscalYearStatus {
  PENDING
  ACTIVE
  CLOSED
}

model TaxTransaction {
  id              String        @id @default(uuid())
  taxType         TaxType

  // Tax amounts
  baseAmount      Decimal       @db.Decimal(15, 2)
  taxRate         Decimal       @db.Decimal(5, 4)
  taxAmount       Decimal       @db.Decimal(15, 2)

  // Document reference
  documentType    String        // INVOICE, PAYMENT, etc.
  documentId      String
  documentNumber  String

  // Period
  period          String        // YYYY-MM format
  taxYear         Int

  // Party
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  supplierId      String?

  // Status
  status          TaxStatus     @default(PENDING)
  filedAt         DateTime?
  filedById       String?

  // GL posting
  journalEntryId  String?
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([taxType, period])
  @@index([status])
  @@index([customerId])
  @@index([documentType, documentId])
  @@map("tax_transactions")
}

enum TaxType {
  VAT
  WHT
  CIT
  EDT
  PAYE
}

enum TaxStatus {
  PENDING
  FILED
  PAID
  OVERDUE
}

model FixedAsset {
  id                  String    @id @default(uuid())
  assetCode           String    @unique
  assetName           String
  description         String?
  category            String

  // Acquisition
  acquisitionDate     DateTime
  acquisitionCost     Decimal   @db.Decimal(15, 2)
  residualValue       Decimal   @default(0) @db.Decimal(15, 2)

  // Depreciation
  usefulLifeYears     Int
  depreciationMethod  DepreciationMethod @default(STRAIGHT_LINE)
  accumulatedDepreciation Decimal @default(0) @db.Decimal(15, 2)
  netBookValue        Decimal   @db.Decimal(15, 2)

  // Location & Custody
  location            String?
  custodian           String?

  // Accounts
  assetAccountId      String
  assetAccount        Account   @relation("AssetAccount", fields: [assetAccountId], references: [id])
  depreciationAccountId String
  depreciationAccount Account   @relation("DepreciationAccount", fields: [depreciationAccountId], references: [id])

  status              AssetStatus @default(ACTIVE)
  disposalDate        DateTime?
  disposalAmount      Decimal?   @db.Decimal(15, 2)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  depreciationEntries FixedAssetDepreciation[]

  @@index([category])
  @@index([status])
  @@map("fixed_assets")
}

enum DepreciationMethod {
  STRAIGHT_LINE
  REDUCING_BALANCE
  UNITS_OF_PRODUCTION
}

enum AssetStatus {
  ACTIVE
  UNDER_MAINTENANCE
  DISPOSED
  WRITTEN_OFF
}

model FixedAssetDepreciation {
  id              String      @id @default(uuid())
  assetId         String
  asset           FixedAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  year            Int
  period          Int         // 1-12 for monthly, or fiscal year

  openingValue    Decimal     @db.Decimal(15, 2)
  depreciationAmount Decimal  @db.Decimal(15, 2)
  closingValue    Decimal     @db.Decimal(15, 2)

  // GL posting
  journalEntryId  String?
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id])

  postedAt        DateTime?

  @@unique([assetId, year, period])
  @@map("fixed_asset_depreciation")
}

model BankAccount {
  id              String    @id @default(uuid())
  accountName     String
  accountNumber   String
  bankCode        String
  bankName        String
  branch          String?

  // Account type
  accountType     BankAccountType @default(CURRENT)
  currency        String    @default("NGN")

  // GL Link
  glAccountId     String
  glAccount       Account   @relation(fields: [glAccountId], references: [id])

  // Opening balance
  openingBalance  Decimal   @default(0) @db.Decimal(15, 2)
  currentBalance  Decimal   @default(0) @db.Decimal(15, 2)

  // Status
  isActive        Boolean   @default(true)
  isDefault       Boolean   @default(false)

  // Relations
  statements      BankStatement[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([accountNumber, bankCode])
  @@map("bank_accounts")
}

enum BankAccountType {
  CURRENT
  SAVINGS
  DOMICILIARY
  PLACEMENT
}

model BankStatement {
  id              String    @id @default(uuid())
  bankAccountId   String
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id])

  statementDate   DateTime
  statementNumber String?

  // Opening/Closing balances
  openingBalance  Decimal   @db.Decimal(15, 2)
  closingBalance  Decimal   @db.Decimal(15, 2)

  // Import status
  importStatus    StatementImportStatus @default(PENDING)
  importedAt      DateTime?
  importedById    String?

  // File reference
  fileUrl         String?
  fileName        String?

  // Relations
  transactions    BankTransaction[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("bank_statements")
}

enum StatementImportStatus {
  PENDING
  PROCESSING
  IMPORTED
  RECONCILED
  ERROR
}

model BankTransaction {
  id              String    @id @default(uuid())
  statementId     String
  statement       BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  transactionDate DateTime
  description     String
  reference       String?

  // Amounts
  debitAmount     Decimal   @default(0) @db.Decimal(15, 2)
  creditAmount    Decimal   @default(0) @db.Decimal(15, 2)
  balance         Decimal   @db.Decimal(15, 2)

  // Reconciliation
  isReconciled    Boolean   @default(false)
  reconciledAt    DateTime?
  reconciledById  String?

  // Link to system transaction
  systemTransactionId   String?
  systemTransactionType String? // PAYMENT, JOURNAL, etc.

  // Suggested match
  suggestedMatchId      String?
  suggestedMatchScore Decimal?    @db.Decimal(5, 2)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([statementId, isReconciled])
  @@map("bank_transactions")
}

// =============================================================================
// Reporting Domain
// =============================================================================

model ReportConfig {
  id          String    @id @default(uuid())
  name        String
  description String?

  // Data source configuration
  dataSource  String    // orders, customers, products, payments, production, inventory
  filters     Json?     // Filter configuration object
  columns     Json?     // Selected columns array
  groupBy     String?   // Group by field
  sortBy      Json?     // Sort configuration

  // Report settings
  isScheduled Boolean   @default(false)
  schedule    String?   // Cron expression for scheduled reports
  recipients  Json?     // Email recipients array
  format      String    @default("json") // json, csv, pdf

  // Metadata
  isActive    Boolean   @default(true)
  isTemplate  Boolean   @default(false)
  createdBy   String
  lastRunAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([dataSource, isActive])
  @@index([createdBy])
  @@map("report_configs")
}
