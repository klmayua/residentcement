{
  "name": "@resident-cement/kernel",
  "version": "1.0.0",
  "description": "Shared kernel for ResidentCement microservices - common types, utilities, error handling, and logging",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --skipLibCheck --noEmitOnError false",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "dependencies": {
    "jose": "^5.10.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-transport": "^4.7.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.21",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/range-parser": "^1.2.7",
    "@types/send": "^1.2.1",
    "@types/uuid": "^9.0.7",
    "@types/yargs-parser": "^21.0.3",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "resident-cement",
    "shared-kernel",
    "microservices",
    "typescript"
  ],
  "license": "PROPRIETARY"
}
