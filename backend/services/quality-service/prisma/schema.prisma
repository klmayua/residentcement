generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model QualityStandard {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  category        String
  description     String?
  specifications  Json?    @default("{}")
  toleranceMin    Float?
  toleranceMax    Float?
  unitOfMeasure   String?
  status          StandardStatus @default(ACTIVE)
  version         String   @default("1.0")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inspections Inspection[]

  @@index([category])
  @@index([status])
}

model Inspection {
  id              String   @id @default(uuid())
  standardId      String
  batchId         String?
  productId       String?
  result          InspectionResult @default(PENDING)
  measurements    Json?    @default("{}")
  notes           String?
  inspectedBy     String   @default("system")
  inspectionDate  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  standard QualityStandard @relation(fields: [standardId], references: [id])

  @@index([standardId])
  @@index([batchId])
  @@index([result])
  @@index([inspectionDate])
}

model NonConformanceReport {
  id              String   @id @default(uuid())
  ncrNumber       String   @unique
  title           String
  description     String
  severity        Severity @default(MEDIUM)
  status          NCRStatus @default(OPEN)
  batchId         String?
  productId       String?
  reportedBy      String   @default("system")
  resolution      String?
  resolvedBy      String?
  resolvedAt      DateTime?
  capaId          String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  capa CAPA?

  @@index([status])
  @@index([severity])
  @@index([batchId])
}

model CAPA {
  id                String   @id @default(uuid())
  capaNumber        String   @unique
  ncrId             String   @unique
  description       String
  rootCause         String?
  correctiveAction  String?
  preventiveAction  String?
  priority          Priority @default(MEDIUM)
  status            CAPAStatus @default(OPEN)
  assignedTo        String?
  dueDate           DateTime?
  verificationNotes String?
  verifiedBy        String?
  closedAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ncr NonConformanceReport @relation(fields: [ncrId], references: [id])

  @@index([status])
  @@index([priority])
  @@index([assignedTo])
}

model Certification {
  id                String   @id @default(uuid())
  certificateNumber String   @unique
  name              String
  type              String
  issuingBody       String?
  issueDate         DateTime
  expiryDate        DateTime?
  status            CertStatus @default(ACTIVE)
  scope             String?
  attachments       Json?    @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([expiryDate])
}

model AuditTrail {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  action      String
  oldValues   Json?    @default("{}")
  newValues   Json?    @default("{}")
  performedBy String   @default("system")
  reason      String?
  createdAt   DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}

enum StandardStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
}

enum InspectionResult {
  PENDING
  PASSED
  FAILED
  INCONCLUSIVE
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NCRStatus {
  OPEN
  UNDER_REVIEW
  CAPA_INITIATED
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CAPAStatus {
  OPEN
  IN_PROGRESS
  VERIFICATION
  CLOSED
}

enum CertStatus {
  ACTIVE
  EXPIRED
  REVOKED
  PENDING
}
