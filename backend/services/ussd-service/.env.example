# USSD Service Environment Configuration
# Africa's Talking Integration for ResidentCement
# =============================================================================

# Africa's Talking API Credentials
# Get these from https://account.africastalking.com/
# For sandbox testing, use username: sandbox
# =============================================================================
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here
AT_SHORTCODE=*384*12345#
AT_SENDER_ID=ResidentCement
AT_SMS_ENABLED=false

# Service Configuration
# =============================================================================
PORT=4008
NODE_ENV=development

# Allowed Origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database Configuration (for session persistence - optional)
# =============================================================================
DATABASE_URL=postgresql://user:password@postgres:5432/residentcement

# Redis Configuration (for session storage - optional)
# =============================================================================
REDIS_URL=redis://:password@redis:6379

# API Gateway URL (for service-to-service communication)
# =============================================================================
API_GATEWAY_URL=http://gateway:3001

# Order Service URL (for placing orders via USSD)
ORDER_SERVICE_URL=http://order-service:3007

# Customer Service URL (for checking balances)
CUSTOMER_SERVICE_URL=http://customer-service:3002
