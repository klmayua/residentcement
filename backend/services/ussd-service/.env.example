# USSD Service Environment Configuration
# Africa's Talking Credentials (required for production)

# Africa's Talking API Credentials
# Get these from https://account.africastalking.com/
AT_USERNAME=your_africastalking_username
AT_API_KEY=your_africastalking_api_key
AT_SHORTCODE=*384*12345#

# Service Configuration
PORT=4008
NODE_ENV=production

# Allowed Origins for CORS
ALLOWED_ORIGINS=https://residentcement.com,https://app.residentcement.com

# Database (for session persistence - optional)
DATABASE_URL=postgresql://user:password@postgres:5432/residentcement

# Redis (for session storage - optional)
REDIS_URL=redis://:password@redis:6379
