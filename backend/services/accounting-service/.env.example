# Server Configuration
PORT=3011
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/residentcement_accounting?schema=public"

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=accounting-service
KAFKA_GROUP_ID=accounting-service-group

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Service Discovery
GATEWAY_URL=http://localhost:3000
SERVICE_NAME=accounting-service

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Nigerian Banking Integration (Optional)
# Enable for live bank reconciliation
BANK_API_ENABLED=false
CBN_API_KEY=

# Tax Configuration
VAT_REGISTRATION_NUMBER=
COMPANY_TIN=
FISCAL_YEAR_START=01-01
DEFAULT_CURRENCY=NGN

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
